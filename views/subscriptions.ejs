<%
  const f = filters || {};
  const qsFn = typeof qsBase === 'function' ? qsBase : () => '';
  const csvQs = qsFn();
  const returnQs = typeof listReturnQs !== 'undefined' ? listReturnQs : csvQs.replace(/^\?/, '');
%>
<div class="page" data-subscriptions>
  <header class="pageHeader pageHeader--compact">
    <div>
      <h1 class="pageHeader__title">Subscriptions</h1>
    </div>
    <div class="pageHeader__actions dashToolbar">
      <button type="button" class="btn btn--ghost btn--mini" data-filter-open="subFilters">
        Filters<% if (activeFilterCount > 0) { %> (<%= activeFilterCount %>)<% } %>
      </button>
      <a class="btn btn--ghost btn--mini" href="/admin/subscriptions.csv<%= csvQs %>">Export</a>
      <% if (canWrite) { %>
        <button type="button" class="btn btn--primary btn--mini" data-filter-open="subCreateDrawer">Create</button>
      <% } %>
    </div>
  </header>

  <section class="panel panel--compact subDataTable">
    <%- include('partials/admin/subscriptions-table', {
      subs, filters: f, pagination, subDisplay, datasetEmpty, activeFilterCount, qsBase: qsFn, canWrite, listReturnQs: returnQs
    }) %>
  </section>

  <form id="subFiltersForm" method="get" action="/admin/subscriptions">
    <input type="hidden" name="page" value="1">
    <div class="filterDrawer" id="subFilters" aria-hidden="true">
      <div class="filterDrawer__backdrop" data-filter-close></div>
      <aside class="filterDrawer__panel filterDrawer__panel--compact" role="dialog" aria-modal="true" aria-labelledby="subFiltersTitle">
        <div class="filterDrawer__head">
          <h2 id="subFiltersTitle" class="filterDrawer__title">Filters</h2>
          <button type="button" class="btn btn--ghost btn--mini btn--icon" data-filter-close aria-label="Close filters">×</button>
        </div>
        <div class="filterDrawer__body filterDrawer__body--compact">
          <%- include('partials/admin/subscriptions-filter-drawer', { filters: f, trackOptions, hasTrackId }) %>
        </div>
        <div class="filterDrawer__foot filterDrawer__foot--compact">
          <a class="btn btn--ghost btn--mini" href="/admin/subscriptions">Reset</a>
          <button type="submit" class="btn btn--primary btn--mini">Apply</button>
        </div>
      </aside>
    </div>
  </form>

  <% if (canWrite) { %>
    <%- include('partials/admin/subscriptions-form-drawer', { formDrawerMode: 'create', hasTrackId }) %>
    <%- include('partials/admin/subscriptions-form-drawer', { formDrawerMode: 'edit', hasTrackId }) %>
  <% } %>
</div>
<script src="/js/admin-subscriptions.js?v=6" defer></script>