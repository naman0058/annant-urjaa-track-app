<%
  const f = filters || {};
  const qsFn = typeof qsBase === 'function' ? qsBase : () => '';
%>
<div class="page" data-audit>
  <header class="pageHeader pageHeader--compact">
    <div>
      <h1 class="pageHeader__title">Audit log</h1>
      <p class="pageHeader__period cellMuted">Sensitive admin actions (metadata only — no secrets).</p>
    </div>
    <div class="pageHeader__actions dashToolbar">
      <button type="button" class="btn btn--ghost btn--mini" data-filter-open="auditFilters">
        Filters<% if (activeFilterCount > 0) { %> (<%= activeFilterCount %>)<% } %>
      </button>
    </div>
  </header>

  <section class="panel panel--compact auditDataTable">
    <%- include('partials/admin/audit-table', {
      rows,
      filters: f,
      pagination,
      datasetEmpty,
      activeFilterCount,
      qsBase: qsFn,
    }) %>
  </section>

  <form id="auditFiltersForm" method="get" action="/admin/audit">
    <input type="hidden" name="page" value="1">
    <div class="filterDrawer" id="auditFilters" aria-hidden="true">
      <div class="filterDrawer__backdrop" data-filter-close></div>
      <aside class="filterDrawer__panel filterDrawer__panel--compact" role="dialog" aria-modal="true" aria-labelledby="auditFiltersTitle">
        <div class="filterDrawer__head">
          <h2 id="auditFiltersTitle" class="filterDrawer__title">Filters</h2>
          <button type="button" class="btn btn--ghost btn--mini btn--icon" data-filter-close aria-label="Close filters">×</button>
        </div>
        <div class="filterDrawer__body filterDrawer__body--compact">
          <%- include('partials/admin/audit-filter-drawer', { filters: f }) %>
        </div>
        <div class="filterDrawer__foot filterDrawer__foot--compact">
          <a class="btn btn--ghost btn--mini" href="/admin/audit">Reset</a>
          <button type="submit" class="btn btn--primary btn--mini">Apply</button>
        </div>
      </aside>
    </div>
  </form>

  <div class="filterDrawer auditDetailDrawer" id="auditDetailDrawer" aria-hidden="true">
    <div class="filterDrawer__backdrop" data-audit-detail-close></div>
    <aside class="filterDrawer__panel filterDrawer__panel--compact filterDrawer__panel--form" role="dialog" aria-labelledby="auditDetailTitle">
      <div class="filterDrawer__head">
        <h2 id="auditDetailTitle" class="filterDrawer__title">Audit details</h2>
        <button type="button" class="btn btn--ghost btn--mini" data-audit-detail-close>Close</button>
      </div>
      <div class="filterDrawer__body filterDrawer__body--compact filterDrawer__stack">
        <dl class="auditDetailDl">
          <dt>When</dt><dd id="auditDetailWhen" class="mono">—</dd>
          <dt>Actor</dt><dd id="auditDetailActor">—</dd>
          <dt>Action</dt><dd id="auditDetailAction">—</dd>
          <dt>Entity</dt><dd id="auditDetailEntity" class="mono">—</dd>
        </dl>
        <label class="field">
          <span class="field__label">Metadata</span>
          <pre class="auditDetailMeta mono" id="auditDetailMeta">—</pre>
        </label>
      </div>
    </aside>
  </div>
</div>
<script src="/js/admin-audit.js?v=1" defer></script>