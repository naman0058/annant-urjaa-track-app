<%
  const f = filters || {};
  const FILTER_KEYS = ['q', 'has_thumb', 'limit'];
  const activeCount = (() => {
    if (typeof activeFilterCount === 'number') return activeFilterCount;
    let n = 0;
    if (String(f.q || '').trim()) n++;
    if (f.has_thumb && f.has_thumb !== 'all') n++;
    if (f.limit && Number(f.limit) !== 20) n++;
    return n;
  })();
  const qsBase = (extra) => {
    const merged = { ...f, ...(extra || {}) };
    const p = new URLSearchParams();
    FILTER_KEYS.forEach((k) => {
      const v = merged[k];
      if (v !== undefined && v !== null && String(v).trim() !== '') {
        if (k === 'has_thumb' && v === 'all') return;
        p.set(k, String(v).trim());
      }
    });
    if (merged.page) p.set('page', merged.page);
    const s = p.toString();
    return s ? ('?' + s) : '';
  };
  const listReturnQs = qsBase().replace(/^\?/, '');
  const canWrite = typeof session !== 'undefined' && session.admin && ['super', 'manager'].includes(session.admin.role);
  const isSuper = typeof session !== 'undefined' && session.admin && session.admin.role === 'super';
%>
<div class="page" data-categories data-csrf="<%= csrfToken %>">
  <header class="pageHeader pageHeader--compact">
    <div>
      <h1 class="pageHeader__title">Categories</h1>
    </div>
    <div class="pageHeader__actions dashToolbar">
      <button type="button" class="btn btn--ghost btn--mini" data-filter-open="catFilters">
        Filters<% if (activeCount > 0) { %> (<%= activeCount %>)<% } %>
      </button>
      <% if (canWrite) { %>
        <button type="button" class="btn btn--ghost btn--mini" data-filter-open="catReorderDrawer">Reorder</button>
        <button type="button" class="btn btn--primary btn--mini" data-filter-open="catCreateDrawer">Create</button>
      <% } %>
    </div>
  </header>

  <section class="panel panel--compact catDataTable">
    <%- include('partials/admin/categories-table', {
      categories, filters: f, pagination, datasetEmpty, qsBase, listReturnQs, canWrite, isSuper, activeFilterCount: activeCount
    }) %>
  </section>

  <form id="catFiltersForm" method="get" action="/admin/categories">
    <input type="hidden" name="page" value="1">
    <div class="filterDrawer" id="catFilters" aria-hidden="true">
      <div class="filterDrawer__backdrop" data-filter-close></div>
      <aside class="filterDrawer__panel filterDrawer__panel--compact" role="dialog" aria-modal="true" aria-labelledby="catFiltersTitle">
        <div class="filterDrawer__head">
          <h2 id="catFiltersTitle" class="filterDrawer__title">Filters</h2>
          <button type="button" class="btn btn--ghost btn--mini btn--icon" data-filter-close aria-label="Close filters">×</button>
        </div>
        <div class="filterDrawer__body filterDrawer__body--compact">
          <%- include('partials/admin/categories-filter-drawer', { filters: f, pagination }) %>
        </div>
        <div class="filterDrawer__foot filterDrawer__foot--compact">
          <a class="btn btn--ghost btn--mini" href="/admin/categories">Reset</a>
          <button type="submit" class="btn btn--primary btn--mini">Apply</button>
        </div>
      </aside>
    </div>
  </form>

  <% if (canWrite) { %>
    <%- include('partials/admin/categories-form-drawer', { formDrawerMode: 'create' }) %>
    <%- include('partials/admin/categories-form-drawer', { formDrawerMode: 'edit', listReturnQs }) %>
    <%- include('partials/admin/categories-reorder-drawer', { orderRows: orderRows || [] }) %>
  <% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js" defer></script>
<script src="/js/admin-categories.js?v=1" defer></script>