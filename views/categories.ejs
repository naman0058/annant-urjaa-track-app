<div class="card">
  <h3>Categories</h3>

  <form class="form-inline" method="post" action="/admin/categories" enctype="multipart/form-data">
    <input type="text" name="name" placeholder="Category name" required>
    <input type="text" name="description" placeholder="Description (optional)">
    <input type="file" name="thumb" accept=".png,.jpg,.jpeg,.webp">
    <button type="submit">Add Category</button>
  </form>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th style="min-width:420px;">Name & Description</th>
        <th>Slug</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% categories.forEach(c => { %>
        <tr>
          <td><%= c.id %></td>

          <td>
            <form class="row" method="post" action="/admin/categories/<%= c.id %>" enctype="multipart/form-data">
              <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                <input type="text" name="name" value="<%= c.name %>" required placeholder="Name">
                <input type="text" name="description" value="<%= c.description || '' %>" placeholder="Description (optional)" style="min-width:260px;">
                <input type="file" name="thumb" accept=".png,.jpg,.jpeg,.webp">
                <% if (c.thumbnail_path) { %>
                  <img src="<%= c.thumbnail_path %>" alt="" style="height:40px;border-radius:8px;margin-left:8px;">
                <% } %>
                <button type="submit">Save</button>
              </div>
            </form>
            <div style="color:var(--textMuted); font-size:12px; margin-top:4px;">
              Slug: <%= c.slug %>
            </div>
          </td>

          <td><%= c.slug %></td>
          <td><%= new Date(c.created_at).toLocaleString() %></td>

          <td>
            <form method="post" action="/admin/categories/<%= c.id %>/delete"
                  onsubmit="return confirm('Delete this category? (Only if no tracks use it)')">
              <button type="submit" class="danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <%- include('partials/pagination', { pagination, base: '/admin/categories', extra: {} }) %>
</div>
