<%
  const f = filters || {};
  const selCat = Number(f.category_id || 0);
  const FILTER_KEYS = ['q', 'category_id', 'type', 'status', 'date_from', 'date_to', 'limit'];
  const activeCount = (() => {
    if (typeof activeFilterCount === 'number') return activeFilterCount;
    let n = 0;
    if (String(f.q || '').trim()) n++;
    if (f.category_id && Number(f.category_id) > 0) n++;
    if (f.type && f.type !== 'all') n++;
    if (f.status && f.status !== 'all') n++;
    if (String(f.date_from || '').trim()) n++;
    if (String(f.date_to || '').trim()) n++;
    if (f.limit && Number(f.limit) !== 20) n++;
    return n;
  })();
  const qsBase = (extra) => {
    const merged = { ...f, ...(extra || {}) };
    const p = new URLSearchParams();
    FILTER_KEYS.forEach((k) => {
      const v = merged[k];
      if (v !== undefined && v !== null && String(v).trim() !== '') {
        if ((k === 'type' || k === 'status') && v === 'all') return;
        if (k === 'category_id' && Number(v) === 0) return;
        p.set(k, String(v).trim());
      }
    });
    if (merged.page) p.set('page', merged.page);
    const s = p.toString();
    return s ? ('?' + s) : '';
  };
  const listReturnQs = qsBase().replace(/^\?/, '');
  const canWrite = typeof session !== 'undefined' && session.admin && ['super', 'manager'].includes(session.admin.role);
  const isSuper = typeof session !== 'undefined' && session.admin && session.admin.role === 'super';
%>
<div class="page" data-tracks data-csrf="<%= csrfToken %>" data-reorder-category="<%= selCat || '' %>">
  <header class="pageHeader pageHeader--compact">
    <div>
      <h1 class="pageHeader__title">Tracks</h1>
    </div>
    <div class="pageHeader__actions dashToolbar">
      <button type="button" class="btn btn--ghost btn--mini" data-filter-open="trackFilters">
        Filters<% if (activeCount > 0) { %> (<%= activeCount %>)<% } %>
      </button>
      <% if (canWrite) { %>
        <button type="button" class="btn btn--ghost btn--mini" data-filter-open="trackReorderDrawer" <%= selCat ? '' : 'disabled title="Select a category in Filters first"' %>>Reorder</button>
        <button type="button" class="btn btn--primary btn--mini" data-filter-open="trackCreateDrawer">Create</button>
      <% } %>
    </div>
  </header>

  <section class="panel panel--compact trackDataTable">
    <%- include('partials/admin/tracks-table', {
      tracks, categories, filters: f, pagination, datasetEmpty, qsBase, listReturnQs, canWrite, isSuper, activeFilterCount: activeCount, selectedCategoryId: selCat
    }) %>
  </section>

  <form id="trackFiltersForm" method="get" action="/admin/tracks">
    <input type="hidden" name="page" value="1">
    <div class="filterDrawer" id="trackFilters" aria-hidden="true">
      <div class="filterDrawer__backdrop" data-filter-close></div>
      <aside class="filterDrawer__panel filterDrawer__panel--compact" role="dialog" aria-modal="true" aria-labelledby="trackFiltersTitle">
        <div class="filterDrawer__head">
          <h2 id="trackFiltersTitle" class="filterDrawer__title">Filters</h2>
          <button type="button" class="btn btn--ghost btn--mini btn--icon" data-filter-close aria-label="Close filters">×</button>
        </div>
        <div class="filterDrawer__body filterDrawer__body--compact">
          <%- include('partials/admin/tracks-filter-drawer', { filters: f, categories, pagination }) %>
        </div>
        <div class="filterDrawer__foot filterDrawer__foot--compact">
          <a class="btn btn--ghost btn--mini" href="/admin/tracks">Reset</a>
          <button type="submit" class="btn btn--primary btn--mini">Apply</button>
        </div>
      </aside>
    </div>
  </form>

  <% if (canWrite) { %>
    <%- include('partials/admin/tracks-form-drawer', { formDrawerMode: 'create', categories, defaultCategoryId: selCat }) %>
    <%- include('partials/admin/tracks-form-drawer', { formDrawerMode: 'edit', categories, listReturnQs }) %>
    <%- include('partials/admin/tracks-reorder-drawer', { orderRows: orderRows || [], categoryId: selCat, categories }) %>
  <% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js" defer></script>
<script src="/js/admin-tracks.js?v=1" defer></script>