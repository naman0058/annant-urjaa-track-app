<%
  const f = filters || {};
  const qsFn = typeof qsBase === 'function' ? qsBase : () => '';
  const csvQs = qsFn();
  const returnQs = typeof listReturnQs !== 'undefined' ? listReturnQs : csvQs.replace(/^\?/, '');
%>
<div class="page" data-users data-csrf="<%= csrfToken %>">
  <header class="pageHeader pageHeader--compact">
    <div>
      <h1 class="pageHeader__title">Users</h1>
    </div>
    <div class="pageHeader__actions dashToolbar">
      <button type="button" class="btn btn--ghost btn--mini" data-filter-open="userFilters">
        Filters<% if (activeFilterCount > 0) { %> (<%= activeFilterCount %>)<% } %>
      </button>
      <a class="btn btn--ghost btn--mini" href="/admin/users.csv<%= csvQs %>">Export</a>
      <% if (canWrite) { %>
        <button type="button" class="btn btn--primary btn--mini" data-filter-open="userCreateDrawer">Create</button>
      <% } %>
    </div>
  </header>

  <section class="panel panel--compact userDataTable">
    <%- include('partials/admin/users-table', {
      users, filters: f, pagination, datasetEmpty, activeFilterCount, qsBase: qsFn, canWrite, listReturnQs: returnQs
    }) %>
  </section>

  <form id="userFiltersForm" method="get" action="/admin/users">
    <input type="hidden" name="page" value="1">
    <div class="filterDrawer" id="userFilters" aria-hidden="true">
      <div class="filterDrawer__backdrop" data-filter-close></div>
      <aside class="filterDrawer__panel filterDrawer__panel--compact" role="dialog" aria-modal="true" aria-labelledby="userFiltersTitle">
        <div class="filterDrawer__head">
          <h2 id="userFiltersTitle" class="filterDrawer__title">Filters</h2>
          <button type="button" class="btn btn--ghost btn--mini btn--icon" data-filter-close aria-label="Close filters">×</button>
        </div>
        <div class="filterDrawer__body filterDrawer__body--compact">
          <%- include('partials/admin/users-filter-drawer', { filters: f }) %>
        </div>
        <div class="filterDrawer__foot filterDrawer__foot--compact">
          <a class="btn btn--ghost btn--mini" href="/admin/users">Reset</a>
          <button type="submit" class="btn btn--primary btn--mini">Apply</button>
        </div>
      </aside>
    </div>
  </form>

  <% if (canWrite) { %>
    <%- include('partials/admin/users-form-drawer', { formDrawerMode: 'create' }) %>
    <%- include('partials/admin/users-form-drawer', { formDrawerMode: 'edit' }) %>
    <input type="hidden" id="userListReturnQs" value="<%= returnQs %>">
  <% } %>
</div>
<script src="/js/admin-users.js?v=1" defer></script>