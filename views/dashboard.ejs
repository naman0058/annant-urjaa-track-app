<%
  const f = filters || {};
  const r = ranges || {};
  const st = stats || {};
  const trackList = trackOptions || [];
  const meta = chartMeta || {};
  const tx = txDisplay || {};
  const inr = (paise) => '₹' + (Number(paise || 0) / 100).toLocaleString('en-IN', { maximumFractionDigits: 0 });
  const qsBase = (extra) => {
    const p = new URLSearchParams();
    if (f.preset) p.set('preset', f.preset);
    if (f.preset === 'custom') {
      if (f.from) p.set('from', f.from);
      if (f.to) p.set('to', f.to);
    }
    if (f.track) p.set('track', f.track);
    if (f.sub_status) p.set('sub_status', f.sub_status);
    if (f.tx_status) p.set('tx_status', f.tx_status);
    if (f.granularity && f.granularity_set === '1') {
      p.set('granularity', f.granularity);
      p.set('granularity_set', '1');
    }
    if (extra) Object.keys(extra).forEach((k) => p.set(k, extra[k]));
    const s = p.toString();
    return s ? ('?' + s) : '';
  };
  const presetLabels = {
    today: 'Today',
    yesterday: 'Yesterday',
    '7d': 'Last 7 days',
    '30d': 'Last 30 days',
    '90d': 'Last 90 days',
    this_month: 'This month',
    last_month: 'Last month',
    custom: 'Custom range',
  };
  const periodLabel = presetLabels[f.preset] || 'Custom range';
%>
<div class="page" data-dashboard>
  <header class="pageHeader pageHeader--compact">
    <div>
      <h1 class="pageHeader__title">Dashboard Overview</h1>
      <span class="pageHeader__period">
        <%= periodLabel %> · <span class="mono"><%= r.from %></span> – <span class="mono"><%= r.to %></span>
        <% if (typeof activeFilterCount !== 'undefined' && activeFilterCount > 0) { %>
          · <span class="filterChip" style="display:inline-flex;margin:0;"><%= activeFilterCount %> filter<%= activeFilterCount > 1 ? 's' : '' %> active</span>
        <% } %>
      </span>
    </div>
    <div class="pageHeader__actions dashToolbar">
      <form class="dashPreset" method="get" action="/admin/dashboard" id="dashPresetForm">
        <% if (f.track) { %><input type="hidden" name="track" value="<%= f.track %>"><% } %>
        <% if (f.sub_status && f.sub_status !== 'all') { %><input type="hidden" name="sub_status" value="<%= f.sub_status %>"><% } %>
        <% if (f.tx_status && f.tx_status !== 'captured') { %><input type="hidden" name="tx_status" value="<%= f.tx_status %>"><% } %>
        <select class="select select--compact" name="preset" id="dashPresetSelect" aria-label="Date period">
          <% if (f.preset === 'custom') { %>
            <option value="custom" selected disabled>Custom range</option>
          <% } %>
          <option value="today" <%= f.preset==='today'?'selected':'' %>>Today</option>
          <option value="yesterday" <%= f.preset==='yesterday'?'selected':'' %>>Yesterday</option>
          <option value="7d" <%= f.preset==='7d'?'selected':'' %>>Last 7 days</option>
          <option value="30d" <%= !f.preset||f.preset==='30d'?'selected':'' %>>Last 30 days</option>
          <option value="90d" <%= f.preset==='90d'?'selected':'' %>>Last 90 days</option>
          <option value="this_month" <%= f.preset==='this_month'?'selected':'' %>>This month</option>
          <option value="last_month" <%= f.preset==='last_month'?'selected':'' %>>Last month</option>
        </select>
      </form>
      <button type="button" class="btn btn--ghost btn--mini" data-filter-open="dashFilters">
        Filters<% if (activeFilterCount > 0) { %> (<%= activeFilterCount %>)<% } %>
      </button>
      <button type="button" class="btn btn--ghost btn--mini" id="dashRefreshBtn" title="Refresh metrics">Refresh</button>
    </div>
  </header>

  <form id="dashFiltersForm" method="get" action="/admin/dashboard">
    <div class="filterDrawer" id="dashFilters" aria-hidden="true">
      <div class="filterDrawer__backdrop" data-filter-close></div>
      <aside class="filterDrawer__panel filterDrawer__panel--compact" role="dialog" aria-modal="true" aria-labelledby="dashFiltersTitle">
        <div class="filterDrawer__head">
          <h2 id="dashFiltersTitle" class="filterDrawer__title">Filters</h2>
          <button type="button" class="btn btn--ghost btn--mini btn--icon" data-filter-close aria-label="Close filters">×</button>
        </div>
        <div class="filterDrawer__body filterDrawer__body--compact">
          <p class="field__hint" id="filterDateError" role="alert" hidden></p>
          <div class="filterDrawer__stack">
            <div class="filterDrawer__section">
              <h3 class="filterDrawer__sectionTitle">Date range</h3>
              <input type="hidden" name="preset" value="custom">
              <div class="fieldGrid fieldGrid--date">
                <label class="field">
                  <span class="field__label" for="filterFrom">From</span>
                  <input class="input input--compact" type="date" id="filterFrom" name="from" value="<%= f.from || '' %>" required>
                </label>
                <label class="field">
                  <span class="field__label" for="filterTo">To</span>
                  <input class="input input--compact" type="date" id="filterTo" name="to" value="<%= f.to || '' %>" required>
                </label>
              </div>
            </div>
            <div class="filterDrawer__section">
              <h3 class="filterDrawer__sectionTitle">Business</h3>
              <div class="filterDrawer__grid">
                <label class="field">
                  <span class="field__label" for="filterTrack">Track</span>
                  <select class="select select--compact" id="filterTrack" name="track">
                    <option value="">All</option>
                    <% trackList.forEach(t => { %>
                      <option value="<%= t %>" <%= String(f.track)===String(t)?'selected':'' %>><%= t %></option>
                    <% }) %>
                  </select>
                </label>
                <label class="field">
                  <span class="field__label" for="filterSubStatus">Subscriptions</span>
                  <select class="select select--compact" id="filterSubStatus" name="sub_status">
                    <% ['all','active','expired','cancelled'].forEach(s => { %>
                      <option value="<%= s %>" <%= (f.sub_status||'all')===s?'selected':'' %>><%= s === 'all' ? 'All' : s %></option>
                    <% }) %>
                  </select>
                </label>
              </div>
              <label class="field">
                <span class="field__label" for="filterTxStatus">Transactions</span>
                <select class="select select--compact" id="filterTxStatus" name="tx_status">
                  <% ['captured','all','created','failed','refunded'].forEach(s => { %>
                    <option value="<%= s %>" <%= (f.tx_status||'captured')===s?'selected':'' %>><%= s %></option>
                  <% }) %>
                </select>
                <span class="field__hint">Revenue defaults to captured; member counts ignore tx status.</span>
              </label>
            </div>
          </div>
        </div>
        <div class="filterDrawer__foot filterDrawer__foot--compact">
          <a class="btn btn--ghost btn--mini" href="/admin/dashboard?preset=30d">Reset</a>
          <button type="submit" class="btn btn--primary btn--mini">Apply</button>
        </div>
      </aside>
    </div>
  </form>

  <section class="statGrid" aria-label="Key metrics">
    <a class="statCard statCard--link" href="/admin/transactions<%= qsBase({ tx_status: f.tx_status || 'captured' }) %>">
      <div class="statCard__icon" aria-hidden="true">₹</div>
      <div class="statCard__label">Captured revenue</div>
      <div class="statCard__value"><%= inr(st.salesAmount) %></div>
      <div class="statCard__meta">
        <span class="<%= st.deltas?.sales?.cssClass %>"><%= st.deltas?.sales?.label %></span>
        <% if (st.deltas?.sales?.label === '—' && !st.salesAmount) { %>
          <span class="delta--flat"> · No previous-period activity</span>
        <% } %>
      </div>
    </a>
    <a class="statCard statCard--link" href="/admin/subscriptions<%= qsBase() %>">
      <div class="statCard__icon statCard__icon--info" aria-hidden="true">◎</div>
      <div class="statCard__label">New subscriptions</div>
      <div class="statCard__value"><%= st.subsCount || 0 %></div>
      <div class="statCard__meta"><span class="<%= st.deltas?.subs?.cssClass %>"><%= st.deltas?.subs?.label %></span></div>
    </a>
    <a class="statCard statCard--link" href="/admin/users<%= qsBase() %>">
      <div class="statCard__icon statCard__icon--info" aria-hidden="true">◌</div>
      <div class="statCard__label">New members</div>
      <div class="statCard__value"><%= st.totalUsers || 0 %></div>
      <div class="statCard__meta"><span class="<%= st.deltas?.users?.cssClass %>"><%= st.deltas?.users?.label %></span></div>
    </a>
    <a class="statCard statCard--link" href="/admin/transactions<%= qsBase({ tx_status: 'failed', preset: '30d' }) %>">
      <div class="statCard__icon statCard__icon--danger" aria-hidden="true">!</div>
      <div class="statCard__label">Failed payments</div>
      <div class="statCard__value"><%= st.failedTxCount || 0 %></div>
      <div class="statCard__meta"><span class="<%= st.deltas?.failed?.cssClass %>"><%= st.deltas?.failed?.label %></span></div>
    </a>
  </section>

  <div class="dashGrid">
    <section class="panel dashGrid__span-8" aria-labelledby="revenueChartTitle">
      <div class="panel__head panel__head--split">
        <h2 id="revenueChartTitle" class="panel__title">Revenue analytics</h2>
        <div class="panel__actions chartCard__menu">
          <form method="get" action="/admin/dashboard" class="chartCard__granularity" id="revenueGranularityForm">
            <% ['preset','from','to','track','sub_status','tx_status'].forEach((key) => {
              if (f.preset !== 'custom' && (key === 'from' || key === 'to')) return;
              if (f[key]) { %><input type="hidden" name="<%= key %>" value="<%= f[key] %>"><% }
            }) %>
            <input type="hidden" name="granularity_set" value="1">
            <select class="select select--compact" name="granularity" aria-label="Revenue chart grouping" onchange="this.form.submit()">
              <option value="daily" <%= meta.granularity==='daily'?'selected':'' %>>Daily</option>
              <option value="weekly" <%= meta.granularity==='weekly'?'selected':'' %>>Weekly</option>
              <option value="monthly" <%= meta.granularity==='monthly'?'selected':'' %>>Monthly</option>
            </select>
          </form>
        </div>
      </div>
      <div class="panel__body panel__body--chart" id="revenueChartWrap">
        <canvas id="revenueChart" role="img" aria-label="Revenue trend chart"></canvas>
        <div class="chartEmpty dashEmpty" id="revenueChartEmpty" hidden role="status">
          <span class="dashEmpty__icon dashEmpty__icon--gold" aria-hidden="true">₹</span>
          <p class="dashEmpty__label">No captured payments in this period.</p>
        </div>
      </div>
    </section>

    <section class="panel dashGrid__span-4" aria-labelledby="subsChartTitle">
      <div class="panel__head">
        <h2 id="subsChartTitle" class="panel__title">Subscription growth</h2>
      </div>
      <div class="panel__body panel__body--chart" id="subsChartWrap">
        <canvas id="subsChart" role="img" aria-label="Subscription growth chart"></canvas>
        <div class="chartEmpty dashEmpty" id="subsChartEmpty" hidden role="status">
          <span class="dashEmpty__icon dashEmpty__icon--info" aria-hidden="true">▣</span>
          <p class="dashEmpty__label">No new subscriptions in this period.</p>
        </div>
      </div>
    </section>

    <section class="panel dashGrid__span-8" aria-labelledby="recentTxTitle">
      <div class="panel__head panel__head--split">
        <h2 id="recentTxTitle" class="panel__title">Recent transactions</h2>
        <a class="btn btn--ghost btn--mini" href="/admin/transactions<%= qsBase() %>">View all</a>
      </div>
      <div class="panel__body panel__body--tight<%= (!(recentTxns||[]).length) ? ' panel__body--empty' : '' %>">
        <% if (!(recentTxns||[]).length) { %>
          <div class="dashEmpty" role="status">
            <span class="dashEmpty__icon dashEmpty__icon--info" aria-hidden="true">◎</span>
            <p class="dashEmpty__label">No transactions in this period.</p>
          </div>
        <% } else { %>
          <table class="table table--dashboard">
            <thead>
              <tr>
                <th>Order</th>
                <th>Customer</th>
                <th class="col-amount">Amount</th>
                <th>Status</th>
                <th class="col-date">Date</th>
              </tr>
            </thead>
            <tbody>
              <% (recentTxns||[]).forEach(t => {
                const badge = tx.txStatusBadgeClass ? tx.txStatusBadgeClass(t.status) : 'info';
                const orderShort = tx.shortOrderId ? tx.shortOrderId(t.order_id) : (t.order_id || '—');
              %>
                <tr>
                  <td class="col-order">
                    <a class="mono" href="/admin/transactions/<%= t.id %>" title="<%= t.order_id || '' %>"><%= orderShort %></a>
                  </td>
                  <td class="col-email" title="<%= t.email || '' %>"><%= t.email || '—' %></td>
                  <td class="mono col-amount"><%= inr(t.amount) %></td>
                  <td><span class="statusBadge statusBadge--<%= badge %>"><%= tx.formatTxStatus ? tx.formatTxStatus(t.status) : t.status %></span></td>
                  <td class="mono col-date"><%= tx.formatTxDateTime ? tx.formatTxDateTime(t.created_at) : t.created_at %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>

    <section class="panel dashGrid__span-4" aria-labelledby="actionTitle">
      <div class="panel__head">
        <h2 id="actionTitle" class="panel__title">Action required</h2>
      </div>
      <div class="panel__body">
        <% const actions = actionQueue || [];
           const hasActions = actions.some((a) => a.count > 0);
        %>
        <% if (!hasActions) { %>
          <div class="emptyState" style="padding:24px 12px;">
            <p class="emptyState__title">You’re all caught up.</p>
            <p>No pending operational items for this view.</p>
          </div>
        <% } else { %>
          <div class="actionList">
            <% actions.forEach((a) => { %>
              <a class="actionList__row" href="<%= a.href %>">
                <span class="actionList__left">
                  <span aria-hidden="true"><%= a.icon || '•' %></span>
                  <span><%= a.label %></span>
                </span>
                <span class="actionList__count"><%= a.count %></span>
                <span class="actionList__arrow" aria-hidden="true">→</span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
  </div>
</div>

<script id="dashboardChartPayload" type="application/json">
<%- JSON.stringify({
  salesSeries: salesSeries || [],
  subsSeries: subsSeries || [],
  granularity: meta.granularity || 'daily',
  stats: { salesAmount: st.salesAmount, subsCount: st.subsCount },
  chartMeta: meta,
  filters: f
}) %>
</script>
<script src="/js/admin-charts.js?v=1" defer></script>
<script src="/js/admin-dashboard.js?v=3" defer></script>