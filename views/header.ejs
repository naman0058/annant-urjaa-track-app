<!DOCTYPE html>
<%
  const seo = typeof seoMeta !== 'undefined' ? seoMeta : null;
  const htmlTitle = seo ? seo.htmlTitle : (typeof pageMetaTitle !== 'undefined' && pageMetaTitle ? pageMetaTitle : 'Anannt Urjaa | PEMF Therapy');
  const htmlDesc = seo ? seo.metaDescription : (typeof pageMetaDescription !== 'undefined' ? pageMetaDescription : '');
  const htmlRobots = seo ? seo.robots : (typeof pageRobots !== 'undefined' ? pageRobots : 'index,follow');
  const htmlCanon = seo ? seo.canonical : (typeof canonical !== 'undefined' ? canonical : '');
  const siteBrand = typeof siteName !== 'undefined' ? siteName : 'Anannt Urjaa';
%>
<html lang="<%= seo ? seo.lang : 'en' %>">
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= htmlTitle %></title>
	<meta name="description" content="<%= htmlDesc %>">
	<% if (seo && seo.metaKeywords) { %>
	<meta name="keywords" content="<%= seo.metaKeywords %>">
	<% } else if (typeof pageMetaKeywords !== 'undefined' && pageMetaKeywords) { %>
	<meta name="keywords" content="<%= pageMetaKeywords %>">
	<% } %>
	<meta name="robots" content="<%= htmlRobots %>">
	<% if (htmlCanon) { %><link rel="canonical" href="<%= htmlCanon %>"><% } %>

	<meta property="og:locale" content="<%= seo ? (seo.locale || 'en_IN') : 'en_IN' %>">
	<meta property="og:site_name" content="<%= siteBrand %>">
	<meta property="og:title" content="<%= seo ? (seo.ogTitle || htmlTitle) : (typeof pageOgTitle !== 'undefined' ? pageOgTitle : htmlTitle) %>">
	<meta property="og:description" content="<%= seo ? (seo.ogDescription || htmlDesc) : (typeof pageOgDescription !== 'undefined' ? pageOgDescription : htmlDesc) %>">
	<meta property="og:type" content="<%= seo ? (seo.ogType || 'website') : ((typeof pageOgTitle !== 'undefined' && pageOgTitle) ? 'article' : 'website') %>">
	<% if (htmlCanon) { %><meta property="og:url" content="<%= htmlCanon %>"><% } %>
	<% const shareImg = seo ? seo.ogImage : (typeof pageOgImage !== 'undefined' ? pageOgImage : ''); %>
	<% if (shareImg) { %>
	<meta property="og:image" content="<%= shareImg %>">
	<% } %>

	<meta name="twitter:card" content="<%= seo ? (seo.twitterCard || 'summary') : (shareImg ? 'summary_large_image' : 'summary') %>">
	<% if (seo && seo.twitterSite) { %><meta name="twitter:site" content="<%= seo.twitterSite %>"><% } %>
	<meta name="twitter:title" content="<%= seo ? (seo.twitterTitle || seo.ogTitle || htmlTitle) : (typeof pageOgTitle !== 'undefined' ? pageOgTitle : htmlTitle) %>">
	<meta name="twitter:description" content="<%= seo ? (seo.twitterDescription || seo.ogDescription || htmlDesc) : (typeof pageOgDescription !== 'undefined' ? pageOgDescription : htmlDesc) %>">
	<% if (shareImg) { %><meta name="twitter:image" content="<%= shareImg %>"><% } %>

	<% if (seo && seo.articlePublished) { %>
	<meta property="article:published_time" content="<%= new Date(seo.articlePublished).toISOString() %>">
	<% } %>
	<% if (seo && seo.articleModified) { %>
	<meta property="article:modified_time" content="<%= new Date(seo.articleModified).toISOString() %>">
	<% } %>
	<% if (seo && seo.articleAuthor) { %>
	<meta property="article:author" content="<%= seo.articleAuthor %>">
	<% } %>
	<!-- Favicon Icon -->
	<link rel="shortcut icon" type="image/x-icon" href="/images/favicon.png">
	<!-- Google Fonts Css-->
	<link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@100..800&amp;display=swap" rel="stylesheet">
	<!-- Bootstrap Css -->
	<link href="/css/bootstrap.min.css" rel="stylesheet" media="screen">
	<!-- SlickNav Css -->
	<link href="/css/slicknav.min.css" rel="stylesheet">
	<!-- Swiper Css -->
	<link rel="stylesheet" href="/css/swiper-bundle.min.css">
	<!-- Font Awesome Icon Css-->
	<link href="/css/all.min.css" rel="stylesheet" media="screen">
	<!-- Animated Css -->
	<link href="/css/animate.css" rel="stylesheet">
    <!-- Magnific Popup Core Css File -->
	<link rel="stylesheet" href="/css/magnific-popup.css">
	<!-- Mouse Cursor Css File -->
	<link rel="stylesheet" href="/css/mousecursor.css">
	<!-- Main Custom Css -->
	<link href="/css/custom.css" rel="stylesheet" media="screen">
</head>
<body>

    <!-- Preloader Start -->
	<div class="preloader">
		<div class="loading-container">
			<div class="loading"></div>
			<div id="loading-icon"><img src="/images/loader.svg" alt=""></div>
		</div>
	</div>
	<!-- Preloader End -->

    <!-- Header Start -->
	<header class="main-header">
		<div class="header-sticky bg-section">
			<nav class="navbar navbar-expand-lg">
				<div class="container-fluid">
					<!-- Logo Start -->
					<a class="navbar-brand" href="/">
						<img src="/images/footer_logo1.svg" alt="Logo">
					</a>
					<!-- Logo End -->

					<!-- Main Menu Start -->
					<div class="collapse navbar-collapse main-menu">
                        <div class="nav-menu-wrapper">
                            <ul class="navbar-nav mr-auto" id="menu">
                               
                                <li class="nav-item"><a class="nav-link" href="/">Home</a>                                
                                <li class="nav-item"><a class="nav-link" href="/about">About Us</a>
                                <li class="nav-item"><a class="nav-link" href="/programs">Programs</a></li>
                                <li class="nav-item"><a class="nav-link" href="/why-pemf">Why PEMF</a></li>
                                <li class="nav-item"><a class="nav-link" href="/blog">Blog</a></li>
                                <li class="nav-item"><a class="nav-link" href="/contact">Contact Us</a></li>
                                <li class="nav-item highlighted-menu"><a class="nav-link" href="#">Download App</a></li>
                            </ul>
                        </div>
                        
                        <!-- Header Btn Start -->
                        <div class="header-btn">
                            <a href="#" class="btn-default">Download App</a>
                        </div>
                        <!-- Header Btn End -->
					</div>
					<!-- Main Menu End -->
					<div class="navbar-toggle"></div>
				</div>
			</nav>
			<div class="responsive-menu"></div>
		</div>
	</header>
	<!-- Header End -->

