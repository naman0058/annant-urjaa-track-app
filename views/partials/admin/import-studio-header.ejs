<header class="pageHeader pageHeader--compact importStudioPageHeader">
  <div class="importStudioPageHeader__main">
    <div class="importStudioPageHeader__titleRow">
      <h1 class="pageHeader__title">Import Studio</h1>
      <span class="importStudio__stepBadge" id="importStepBadge" hidden>Step 1</span>
    </div>
    <p class="pageHeader__period cellMuted" id="importHeaderSubtitle">Scan documents, configure AI, and queue a background import job.</p>
  </div>
  <div class="pageHeader__actions dashToolbar importStudioPageHeader__actions" id="importHeaderToolbar">
    <button type="button" class="btn btn--ghost btn--mini importHeader__filterFiles" data-filter-open="importFileFilters" id="importHeaderFileFilters" hidden>
      Filters<span class="importFilterCount" id="importFileFilterCount" hidden></span>
    </button>
    <button type="button" class="btn btn--ghost btn--mini importHeader__aiConfig" data-filter-open="importAiDrawer" id="importHeaderAi" hidden>AI settings</button>
  </div>
</header>