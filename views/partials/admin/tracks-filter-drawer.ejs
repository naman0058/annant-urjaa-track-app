<%
  const f = filters || {};
  const pg = pagination || { limit: 20 };
  const cats = categories || [];
%>
<div class="filterDrawer__stack">
  <div class="filterDrawer__section">
    <h3 class="filterDrawer__sectionTitle">Search</h3>
    <label class="field">
      <span class="field__label">Track title</span>
      <input class="input input--compact" type="search" name="q" value="<%= f.q || '' %>" placeholder="Search by title" autocomplete="off">
    </label>
  </div>
  <div class="filterDrawer__section">
    <h3 class="filterDrawer__sectionTitle">Catalog</h3>
    <div class="filterDrawer__grid">
      <label class="field">
        <span class="field__label">Category</span>
        <select class="select select--compact" name="category_id">
          <option value="0" <%= !f.category_id || Number(f.category_id)===0 ? 'selected' : '' %>>All categories</option>
          <% cats.forEach((c) => { %>
            <option value="<%= c.id %>" <%= Number(f.category_id)===Number(c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Type</span>
        <select class="select select--compact" name="type">
          <option value="all" <%= (f.type||'all')==='all'?'selected':'' %>>Any</option>
          <option value="free" <%= f.type==='free'?'selected':'' %>>Free</option>
          <option value="premium" <%= f.type==='premium'?'selected':'' %>>Premium</option>
        </select>
      </label>
      <label class="field">
        <span class="field__label">Status</span>
        <select class="select select--compact" name="status">
          <option value="all" <%= (f.status||'all')==='all'?'selected':'' %>>Any</option>
          <option value="active" <%= f.status==='active'?'selected':'' %>>Active</option>
          <option value="inactive" <%= f.status==='inactive'?'selected':'' %>>Inactive</option>
        </select>
      </label>
    </div>
    <div class="fieldGrid fieldGrid--date">
      <label class="field">
        <span class="field__label">Created from</span>
        <input class="input input--compact" type="date" name="date_from" value="<%= f.date_from || '' %>">
      </label>
      <label class="field">
        <span class="field__label">Created to</span>
        <input class="input input--compact" type="date" name="date_to" value="<%= f.date_to || '' %>">
      </label>
    </div>
    <label class="field">
      <span class="field__label">Per page</span>
      <select class="select select--compact" name="limit">
        <% [10,20,50,100].forEach((n) => { %>
          <option value="<%= n %>" <%= Number(f.limit || pg.limit || 20)===n?'selected':'' %>><%= n %></option>
        <% }) %>
      </select>
    </label>
  </div>
</div>