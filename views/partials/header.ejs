<%
  const pageTitle = (typeof title !== 'undefined' && title) ? title : 'Admin';
  const adminUser = (session && session.admin) ? session.admin : null;
  const initials = (adminUser && adminUser.name)
    ? adminUser.name.split(' ').map(s => s[0]).join('').slice(0, 2).toUpperCase()
    : 'AD';
%>
<header class="admin-topbar">
  <div class="admin-topbar__left">
    <button type="button" class="admin-topbar__menu" id="adminMenuBtn" aria-label="Open navigation">☰</button>
    <div class="admin-topbar__breadcrumb">
      <span class="admin-topbar__eyebrow">iTorus / Admin</span>
      <span class="admin-topbar__title visually-hidden"><%= pageTitle %></span>
    </div>
  </div>

  <div class="admin-topbar__right">
    <form class="admin-search" action="/admin/search" method="get" role="search">
      <span class="admin-search__icon" aria-hidden="true">⌕</span>
      <input
        type="search"
        name="q"
        id="adminGlobalSearch"
        placeholder="Quick search payments, orders, email…"
        autocomplete="off"
        aria-label="Global admin search"
      >
    </form>

    <div class="admin-userchip" title="<%= adminUser ? adminUser.email : '' %>">
      <span class="admin-userchip__avatar" aria-hidden="true"><%= initials %></span>
      <span class="admin-userchip__name"><%= adminUser ? (adminUser.name || 'Admin') : 'Admin' %></span>
    </div>
  </div>
</header>