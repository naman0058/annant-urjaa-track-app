<%
// Expected:
// txns: [{ created_at, order_id, payment_id, receipt, email, amount, currency, status, method }]
// filters: { q, status, method, from, to, min_amount, max_amount, has_receipt, has_payment_id, sort, dir, page, limit }
// pagination: { page, limit, total }
const f = filters || {};
const qs = (obj) => new URLSearchParams(Object.fromEntries(
  Object.entries(obj || {}).filter(([_, v]) => v !== undefined && v !== null && String(v).trim() !== '')
)).toString();

const activeFilterCount = (() => {
  const keys = ['q','status','method','from','to','min_amount','max_amount','has_receipt','has_payment_id','sort','dir'];
  return keys.reduce((acc, k) => (String(f[k] || '').trim() ? acc + 1 : acc), 0);
})();
%>

<div class="dashTx">
  <!-- Header -->
  <header class="dashTx__header">
    <div class="dashTx__titleBlock">
      <h2 class="dashTx__title">Transactions</h2>
      <div class="dashTx__subtitle">
        Search, filter, and export payments. Designed for high-volume back-office workflows.
      </div>
    </div>

    <div class="dashTx__actions">
      <a class="btn btn--ghost" href="/admin/transactions?<%= qs({ limit: f.limit || pagination.limit || 20 }) %>">Reset</a>
      <a class="btn btn--gold" href="/admin/transactions.csv?<%= qs(f) %>">Export CSV</a>
    </div>
  </header>

  <!-- Filters Panel -->
  <section class="panel panel--filters">
    <div class="panel__head panel__head--split">
      <div>
        <h3 class="panel__title">Search & Filters</h3>
        <div class="panel__desc">
          Use quick search for Order ID / Payment ID / Receipt / Email. Expand advanced filters for precise control.
        </div>
      </div>

      <div class="chips">
        <span class="chip">Active filters: <%= activeFilterCount %></span>
        <span class="chip">Records on page: <%= (txns || []).length %></span>
        <span class="chip">Limit: <%= pagination.limit %></span>
      </div>
    </div>

    <div class="panel__body">
      <form id="txFilterForm" class="filters" method="get" action="/admin/transactions" autocomplete="off">
        <!-- Quick search -->
        <div class="field field--wide">
          <label class="label">Quick Search</label>
          <div class="inputWrap">
            <span class="icon" aria-hidden="true">⌕</span>
            <input
              class="input input--withIcon"
              type="text"
              name="q"
              value="<%= f.q || '' %>"
              placeholder="Order ID, Payment ID, Receipt, Email…"
              spellcheck="false"
            >
            <button class="btn btn--mini btn--ghost" type="button" id="btnClearSearch" title="Clear">Clear</button>
          </div>

          <!-- Search helpers (brand-like UX) -->
          <div class="helperRow">
            <button class="pillBtn" type="button" data-q="status:captured">status:captured</button>
            <button class="pillBtn" type="button" data-q="method:upi">method:upi</button>
            <button class="pillBtn" type="button" data-q="email:@gmail.com">email:@gmail.com</button>
          </div>

          <div class="tinyHint">
            Tip: You can combine filters below with quick search. Keep search short for best performance.
          </div>
        </div>

        <!-- Primary filters -->
        <div class="field">
          <label class="label">Status</label>
          <select class="select" name="status">
            <option value="">All</option>
            <option value="created"    <%= f.status==='created'?'selected':'' %>>created</option>
            <option value="authorized" <%= f.status==='authorized'?'selected':'' %>>authorized</option>
            <option value="captured"   <%= f.status==='captured'?'selected':'' %>>captured</option>
            <option value="failed"     <%= f.status==='failed'?'selected':'' %>>failed</option>
            <option value="refunded"   <%= f.status==='refunded'?'selected':'' %>>refunded</option>
          </select>
        </div>

        <div class="field">
          <label class="label">Method</label>
          <select class="select" name="method">
            <option value="">All</option>
            <option value="card"       <%= f.method==='card'?'selected':'' %>>card</option>
            <option value="upi"        <%= f.method==='upi'?'selected':'' %>>upi</option>
            <option value="netbanking" <%= f.method==='netbanking'?'selected':'' %>>netbanking</option>
            <option value="wallet"     <%= f.method==='wallet'?'selected':'' %>>wallet</option>
          </select>
        </div>

        <div class="field">
          <label class="label">From</label>
          <input class="input" type="date" name="from" value="<%= f.from || '' %>">
        </div>

        <div class="field">
          <label class="label">To</label>
          <input class="input" type="date" name="to" value="<%= f.to || '' %>">
        </div>

        <!-- Advanced toggle -->
        <div class="field field--actions">
          <button class="btn btn--ghost" type="button" id="btnToggleAdvanced" aria-expanded="false">
            Advanced
          </button>
        </div>

        <!-- Advanced area -->
        <div id="advancedArea" class="advanced" hidden>
          <div class="advGrid">
            <div class="field">
              <label class="label">Min Amount (₹)</label>
              <input class="input" type="number" step="0.01" min="0" name="min_amount" value="<%= f.min_amount || '' %>" placeholder="e.g., 99.00">
            </div>

            <div class="field">
              <label class="label">Max Amount (₹)</label>
              <input class="input" type="number" step="0.01" min="0" name="max_amount" value="<%= f.max_amount || '' %>" placeholder="e.g., 1999.00">
            </div>

            <div class="field">
              <label class="label">Has Payment ID</label>
              <select class="select" name="has_payment_id">
                <option value="">Any</option>
                <option value="1" <%= f.has_payment_id==='1'?'selected':'' %>>Yes</option>
                <option value="0" <%= f.has_payment_id==='0'?'selected':'' %>>No</option>
              </select>
            </div>

            <div class="field">
              <label class="label">Has Receipt</label>
              <select class="select" name="has_receipt">
                <option value="">Any</option>
                <option value="1" <%= f.has_receipt==='1'?'selected':'' %>>Yes</option>
                <option value="0" <%= f.has_receipt==='0'?'selected':'' %>>No</option>
              </select>
            </div>

            <div class="field">
              <label class="label">Sort By</label>
              <select class="select" name="sort">
                <option value="created_at" <%= (!f.sort || f.sort==='created_at')?'selected':'' %>>Time</option>
                <option value="amount"     <%= f.sort==='amount'?'selected':'' %>>Amount</option>
                <option value="status"     <%= f.sort==='status'?'selected':'' %>>Status</option>
                <option value="method"     <%= f.sort==='method'?'selected':'' %>>Method</option>
              </select>
            </div>

            <div class="field">
              <label class="label">Direction</label>
              <select class="select" name="dir">
                <option value="desc" <%= (!f.dir || f.dir==='desc')?'selected':'' %>>Descending</option>
                <option value="asc"  <%= f.dir==='asc'?'selected':'' %>>Ascending</option>
              </select>
            </div>

            <div class="field">
              <label class="label">Per Page</label>
              <select class="select" name="limit">
                <% [10,20,50,100,200].forEach(n => { %>
                  <option value="<%= n %>" <%= Number(pagination.limit)===n ? 'selected' : '' %>><%= n %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <!-- Hidden page reset -->
        <input type="hidden" name="page" value="1">

        <div class="filterBar">
          <button class="btn btn--primary" type="submit">Apply</button>
          <a class="btn btn--ghost" href="/admin/transactions?<%= qs({ limit: f.limit || pagination.limit || 20 }) %>">Clear All</a>
        </div>
      </form>
    </div>
  </section>

  <!-- Results -->
  <section class="panel">
    <div class="panel__head panel__head--split">
      <div>
        <h3 class="panel__title">Results</h3>
        <div class="panel__desc">
          Click table headers to sort quickly. Use export for reconciliation and audits.
        </div>
      </div>

      <div class="panelRight">
        <div class="kpi">
          <div class="kpi__label">Total</div>
          <div class="kpi__value"><%= pagination.total %></div>
        </div>
      </div>
    </div>

    <div class="panel__body panel__body--tight">
      <div class="tableWrap">
        <table class="table">
          <thead>
            <tr>
              <th>
                <a class="thLink" href="/admin/transactions?<%= qs({ ...f, sort: 'created_at', dir: (f.sort==='created_at' && (f.dir||'desc')==='desc') ? 'asc' : 'desc', page: 1 }) %>">
                  Time
                  <span class="sortMark"><%= (f.sort==='created_at' ? ((f.dir||'desc')==='asc'?'↑':'↓') : '') %></span>
                </a>
              </th>

              <th>Order ID</th>
              <th>Payment ID</th>
              <th>Receipt</th>

              <th>
                <span class="thStatic">Email</span>
              </th>

              <th class="taRight">
                <a class="thLink" href="/admin/transactions?<%= qs({ ...f, sort: 'amount', dir: (f.sort==='amount' && (f.dir||'desc')==='desc') ? 'asc' : 'desc', page: 1 }) %>">
                  Amount (₹)
                  <span class="sortMark"><%= (f.sort==='amount' ? ((f.dir||'desc')==='asc'?'↑':'↓') : '') %></span>
                </a>
              </th>

              <th>
                <a class="thLink" href="/admin/transactions?<%= qs({ ...f, sort: 'status', dir: (f.sort==='status' && (f.dir||'desc')==='desc') ? 'asc' : 'desc', page: 1 }) %>">
                  Status
                  <span class="sortMark"><%= (f.sort==='status' ? ((f.dir||'desc')==='asc'?'↑':'↓') : '') %></span>
                </a>
              </th>

              <th>
                <a class="thLink" href="/admin/transactions?<%= qs({ ...f, sort: 'method', dir: (f.sort==='method' && (f.dir||'desc')==='desc') ? 'asc' : 'desc', page: 1 }) %>">
                  Method
                  <span class="sortMark"><%= (f.sort==='method' ? ((f.dir||'desc')==='asc'?'↑':'↓') : '') %></span>
                </a>
              </th>
            </tr>
          </thead>

          <tbody>
            <% if (!txns || !txns.length) { %>
              <tr>
                <td colspan="8" class="empty">
                  No transactions found for the selected filters.
                </td>
              </tr>
            <% } %>

            <% (txns || []).forEach(t => { %>
              <tr>
                <td class="mono"><%= new Date(t.created_at).toLocaleString() %></td>

                <td class="mono">
                  <div class="cellMain"><%= t.order_id %></div>
                  <div class="cellSub">Order</div>
                </td>

                <td class="mono">
                  <div class="cellMain"><%= t.payment_id || '-' %></div>
                  <div class="cellSub">Payment</div>
                </td>

                <td class="mono">
                  <div class="cellMain"><%= t.receipt || '-' %></div>
                  <div class="cellSub">Receipt</div>
                </td>

                <td>
                  <div class="cellMain"><%= t.email || '-' %></div>
                  <div class="cellSub">Customer</div>
                </td>

                <td class="taRight mono">
                  <%= Number(t.amount || 0).toFixed(2) %>
                </td>

                <td>
                  <% const st = String(t.status || '').toLowerCase(); %>
                  <span class="badge <%= st==='captured'?'badge--ok':(st==='failed'?'badge--danger':(st==='refunded'?'badge--warn':'badge--soft')) %>">
                    <%= t.status %>
                  </span>
                </td>

                <td>
                  <span class="badge badge--soft"><%= t.method || '-' %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="pager">
        <%- include('partials/pagination', { pagination, base: '/admin/transactions', extra: f }) %>
      </div>
    </div>
  </section>
</div>

<script>
  (function () {
    const form = document.getElementById('txFilterForm');
    const adv = document.getElementById('advancedArea');
    const toggle = document.getElementById('btnToggleAdvanced');
    const clearBtn = document.getElementById('btnClearSearch');
    const qInput = form?.querySelector('input[name="q"]');

    function setAdvanced(open) {
      if (!adv || !toggle) return;
      adv.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Hide Advanced' : 'Advanced';
      try { localStorage.setItem('tx_adv_open', open ? '1' : '0'); } catch {}
    }

    // default open if any advanced filter is active OR last choice stored
    const advancedKeys = ['min_amount','max_amount','has_receipt','has_payment_id','sort','dir','limit'];
    const url = new URL(window.location.href);
    const hasAdvActive = advancedKeys.some(k => (url.searchParams.get(k) || '').trim() !== '');
    let stored = '0';
    try { stored = localStorage.getItem('tx_adv_open') || '0'; } catch {}
    setAdvanced(hasAdvActive || stored === '1');

    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setAdvanced(open);
    });

    clearBtn?.addEventListener('click', () => {
      if (!qInput) return;
      qInput.value = '';
      qInput.focus();
    });

    // Helper chips inject quick search text
    document.querySelectorAll('.pillBtn[data-q]').forEach(btn => {
      btn.addEventListener('click', () => {
        if (!qInput) return;
        const val = btn.getAttribute('data-q') || '';
        qInput.value = val;
        qInput.focus();
      });
    });

    // UX: Enter submits, but prevents accidental double submits
    form?.addEventListener('submit', () => {
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Applying...';
      }
    });
  })();
</script>

<style>
  :root{
    --bg:#070707;
    --card:#0B0B0B;
    --card2:#101010;
    --text:#F4F4F4;
    --muted:rgba(244,244,244,.72);
    --muted2:rgba(244,244,244,.55);
    --gold:#C9A03B;
    --goldSoft:rgba(201,160,59,.12);
    --gold2:rgba(201,160,59,.14);
    --goldBorder:rgba(201,160,59,.22);
    --softBorder:rgba(255,255,255,.08);
    --shadow:0 18px 60px rgba(0,0,0,.55);
    --danger:#EF4444;
    --dangerBorder:rgba(239,68,68,.35);
    --ok: rgba(34,197,94,.85);
    --warn: rgba(245,158,11,.92);
  }

  *{box-sizing:border-box}
  html,body{max-width:100%;overflow-x:hidden}

  .dashTx{display:flex;flex-direction:column;gap:14px;color:var(--text)}
  .dashTx__header{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap}
  .dashTx__title{margin:0;font-size:22px;letter-spacing:.2px}
  .dashTx__subtitle{margin-top:6px;font-size:13px;color:var(--muted);max-width:980px}
  .dashTx__actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}

  .panel{
    background:linear-gradient(180deg,var(--card),var(--card2));
    border:1px solid var(--goldBorder);
    border-radius:16px;
    box-shadow:var(--shadow);
    overflow:hidden;
    min-width:0;
  }
  .panel__head{
    padding:14px 16px 12px;
    border-bottom:1px solid var(--softBorder);
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:12px;
    flex-wrap:wrap;
  }
  .panel__head--split{align-items:flex-start}
  .panel__title{margin:0;font-size:16px;letter-spacing:.2px}
  .panel__desc{margin-top:8px;font-size:12px;color:var(--muted2);line-height:1.45}
  .panel__body{padding:16px;min-width:0}
  .panel__body--tight{padding-top:12px}
  .panel--filters{border-color:rgba(201,160,59,.30)}

  .chips{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .chip{
    font-size:12px;
    padding:6px 10px;
    border-radius:999px;
    border:1px solid rgba(201,160,59,.20);
    background:rgba(201,160,59,.08);
    color:rgba(244,244,244,.85);
  }

  .btn{
    display:inline-flex;align-items:center;justify-content:center;
    padding:10px 14px;border-radius:12px;min-height:40px;
    border:1px solid var(--softBorder);
    background:transparent;color:var(--text);
    font-weight:900;font-size:13px;line-height:1;
    cursor:pointer;white-space:nowrap;
    transition:transform .08s ease,border-color .15s ease,background .15s ease;
  }
  .btn:hover{border-color:rgba(201,160,59,.35);background:rgba(201,160,59,.07)}
  .btn:active{transform:scale(.98)}
  .btn:disabled{opacity:.6;cursor:not-allowed}
  .btn--primary{background:var(--gold);color:#0A0A0A;border-color:rgba(201,160,59,.55)}
  .btn--primary:hover{background:#D7B256;border-color:rgba(201,160,59,.80)}
  .btn--gold{background:var(--gold2);border-color:rgba(201,160,59,.38)}
  .btn--ghost{background:transparent;border-color:rgba(201,160,59,.22);color:rgba(244,244,244,.92)}
  .btn--ghost:hover{background:rgba(201,160,59,.07)}
  .btn--mini{min-height:34px;padding:8px 10px;border-radius:10px;font-weight:900}

  .field{display:flex;flex-direction:column;gap:7px;min-width:0}
  .field--wide{grid-column:1 / -1}
  .field--actions{display:flex;justify-content:flex-end;align-items:end}

  .label{font-size:12px;color:var(--muted2);font-weight:800}
  .tinyHint{font-size:11px;color:rgba(244,244,244,.45);margin-top:6px}
  .input,.select{
    width:100%;
    padding:10px 12px;
    border-radius:12px;
    border:1px solid rgba(201,160,59,.18);
    background:rgba(255,255,255,.03);
    color:var(--text);
    outline:none;
    font-size:13px;
    min-width:0;
  }
  .input:focus,.select:focus{
    border-color:rgba(201,160,59,.55);
    box-shadow:0 0 0 3px rgba(201,160,59,.12);
  }

  .inputWrap{position:relative;display:flex;gap:8px;align-items:center}
  .icon{
    position:absolute;left:12px;top:50%;transform:translateY(-50%);
    color:rgba(244,244,244,.55);font-size:13px;pointer-events:none;
  }
  .input--withIcon{padding-left:34px}

  .helperRow{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
  .pillBtn{
    border:1px solid rgba(201,160,59,.20);
    background:rgba(201,160,59,.08);
    color:rgba(244,244,244,.88);
    padding:6px 10px;
    border-radius:999px;
    font-size:12px;
    font-weight:900;
    cursor:pointer;
  }
  .pillBtn:hover{background:rgba(201,160,59,.12)}

  .filters{
    display:grid;
    grid-template-columns: 2.2fr 1fr 1fr 1fr 1fr auto;
    gap:12px;
    align-items:end;
  }

  .advanced{
    grid-column:1 / -1;
    margin-top:4px;
    padding-top:12px;
    border-top:1px solid rgba(255,255,255,.08);
  }
  .advGrid{
    display:grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr 1fr;
    gap:12px;
    align-items:end;
  }

  .filterBar{
    grid-column:1 / -1;
    display:flex;
    gap:10px;
    align-items:center;
    justify-content:flex-end;
    margin-top:2px;
    padding-top:10px;
  }

  .panelRight{display:flex;gap:10px;align-items:center}
  .kpi{
    border:1px solid rgba(201,160,59,.18);
    background:rgba(201,160,59,.06);
    border-radius:14px;
    padding:10px 12px;
    min-width:140px;
  }
  .kpi__label{font-size:12px;color:rgba(244,244,244,.70);font-weight:900}
  .kpi__value{font-size:18px;font-weight:900;margin-top:4px}

  .tableWrap{overflow:auto;border-radius:14px;border:1px solid rgba(201,160,59,.14)}
  .table{
    width:100%;
    border-collapse:separate;
    border-spacing:0;
    min-width:980px;
    background:rgba(0,0,0,.12);
  }
  .table th,.table td{
    padding:12px 12px;
    border-bottom:1px solid rgba(255,255,255,.06);
    vertical-align:top;
    font-size:13px;
  }
  .table thead th{
    position:sticky;top:0;
    background:rgba(11,11,11,.92);
    backdrop-filter: blur(6px);
    z-index:2;
    color:rgba(244,244,244,.85);
    text-align:left;
  }
  .taRight{text-align:right}
  .mono{font-family: ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace}

  .thLink{
    color:rgba(244,244,244,.88);
    text-decoration:none;
    font-weight:900;
    display:inline-flex;
    gap:8px;
    align-items:center;
  }
  .thLink:hover{text-decoration:underline}
  .sortMark{opacity:.7}

  .cellMain{font-weight:900}
  .cellSub{margin-top:4px;font-size:11px;color:rgba(244,244,244,.50)}

  .badge{
    display:inline-flex;align-items:center;justify-content:center;
    font-size:12px;font-weight:900;
    padding:6px 10px;border-radius:999px;
    border:1px solid rgba(201,160,59,.18);
    background:rgba(201,160,59,.06);
    color:rgba(244,244,244,.88);
    width:fit-content;
    text-transform:lowercase;
  }
  .badge--ok{border-color:rgba(34,197,94,.35);background:rgba(34,197,94,.10)}
  .badge--danger{border-color:rgba(239,68,68,.35);background:rgba(239,68,68,.10);color:#FCA5A5}
  .badge--warn{border-color:rgba(245,158,11,.35);background:rgba(245,158,11,.10)}
  .badge--soft{border-color:rgba(255,255,255,.10);background:rgba(255,255,255,.04);color:rgba(244,244,244,.82)}

  .empty{
    text-align:center;
    padding:22px 12px;
    color:rgba(244,244,244,.72);
  }

  .pager{margin-top:12px}

  @media (max-width: 1280px){
    .filters{grid-template-columns: 1fr 1fr 1fr 1fr 1fr;}
    .field--actions{justify-content:flex-start}
    .advGrid{grid-template-columns:1fr 1fr 1fr 1fr}
    .filterBar{justify-content:flex-start}
  }

  @media (max-width: 768px){
    .filters{grid-template-columns:1fr}
    .advGrid{grid-template-columns:1fr}
    .filterBar{flex-direction:column;align-items:stretch}
    .filterBar .btn{width:100%}
    .dashTx__actions{width:100%}
    .dashTx__actions .btn{width:100%}
  }

  .dashTx,.panel,.panel__body{overflow-x:hidden}
</style>
