<%
  const f = filters || {};
  const FILTER_KEYS = ['q', 'status', 'method', 'from', 'to', 'min_amount', 'max_amount', 'has_receipt', 'has_payment_id', 'currency', 'sort', 'dir', 'limit'];
  const activeCount = (() => {
    if (typeof activeFilterCount === 'number') return activeFilterCount;
    return FILTER_KEYS.reduce((acc, k) => (String(f[k] || '').trim() ? acc + 1 : acc), 0);
  })();
  const qsBase = (extra) => {
    const merged = { ...f, ...(extra || {}) };
    const p = new URLSearchParams();
    FILTER_KEYS.forEach((k) => {
      const v = merged[k];
      if (v !== undefined && v !== null && String(v).trim() !== '') p.set(k, String(v).trim());
    });
    if (merged.page) p.set('page', merged.page);
    const s = p.toString();
    return s ? ('?' + s) : '';
  };
  const csvQs = qsBase();
  const listReturnQs = csvQs.replace(/^\?/, '');
%>
<div class="page" data-transactions>
  <header class="pageHeader pageHeader--compact">
    <div>
      <h1 class="pageHeader__title">Transactions</h1>
    </div>
    <div class="pageHeader__actions dashToolbar">
      <button type="button" class="btn btn--ghost btn--mini" data-filter-open="txFilters">
        Filters<% if (activeCount > 0) { %> (<%= activeCount %>)<% } %>
      </button>
      <a class="btn btn--ghost btn--mini" href="/admin/transactions.csv<%= csvQs %>">Export</a>
    </div>
  </header>

  <section class="panel panel--compact txDataTable">
    <%- include('partials/admin/transactions-table', {
      txns, filters: f, pagination, txDisplay, datasetEmpty, qsBase, listReturnQs, activeFilterCount: activeCount
    }) %>
  </section>

  <form id="txFiltersForm" method="get" action="/admin/transactions">
    <input type="hidden" name="page" value="1">
    <div class="filterDrawer" id="txFilters" aria-hidden="true">
      <div class="filterDrawer__backdrop" data-filter-close></div>
      <aside class="filterDrawer__panel filterDrawer__panel--compact" role="dialog" aria-modal="true" aria-labelledby="txFiltersTitle">
        <div class="filterDrawer__head">
          <h2 id="txFiltersTitle" class="filterDrawer__title">Filters</h2>
          <button type="button" class="btn btn--ghost btn--mini btn--icon" data-filter-close aria-label="Close filters">×</button>
        </div>
        <div class="filterDrawer__body filterDrawer__body--compact">
          <%- include('partials/admin/transactions-filter-drawer', { filters: f, pagination }) %>
        </div>
        <div class="filterDrawer__foot filterDrawer__foot--compact">
          <a class="btn btn--ghost btn--mini" href="/admin/transactions">Reset</a>
          <button type="submit" class="btn btn--primary btn--mini">Apply</button>
        </div>
      </aside>
    </div>
  </form>
</div>
<script src="/js/admin-transactions.js?v=2" defer></script>