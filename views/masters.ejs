<%
  const f = filters || {};
  const FILTER_KEYS = ['q', 'status', 'valid', 'limit'];
  const activeCount = (() => {
    if (typeof activeFilterCount === 'number') return activeFilterCount;
    let n = 0;
    if (String(f.q || '').trim()) n++;
    if (f.status && f.status !== 'all') n++;
    if (f.valid && f.valid !== 'all') n++;
    if (f.limit && Number(f.limit) !== 20) n++;
    return n;
  })();
  const qsBase = (extra) => {
    const merged = { ...f, ...(extra || {}) };
    const p = new URLSearchParams();
    FILTER_KEYS.forEach((k) => {
      const v = merged[k];
      if (v !== undefined && v !== null && String(v).trim() !== '') {
        if ((k === 'status' || k === 'valid') && v === 'all') return;
        p.set(k, String(v).trim());
      }
    });
    if (merged.page) p.set('page', merged.page);
    const s = p.toString();
    return s ? ('?' + s) : '';
  };
  const listReturnQs = qsBase().replace(/^\?/, '');
  const canWrite = typeof session !== 'undefined' && session.admin && ['super', 'manager'].includes(session.admin.role);
  const isSuper = typeof session !== 'undefined' && session.admin && session.admin.role === 'super';
%>
<div class="page" data-masters>
  <header class="pageHeader pageHeader--compact">
    <div>
      <h1 class="pageHeader__title">Master codes</h1>
    </div>
    <div class="pageHeader__actions dashToolbar">
      <button type="button" class="btn btn--ghost btn--mini" data-filter-open="masterFilters">
        Filters<% if (activeCount > 0) { %> (<%= activeCount %>)<% } %>
      </button>
      <% if (canWrite) { %>
        <button type="button" class="btn btn--primary btn--mini" data-filter-open="masterCreateDrawer">Create</button>
      <% } %>
    </div>
  </header>

  <section class="panel panel--compact masterDataTable">
    <%- include('partials/admin/masters-table', {
      codes, filters: f, pagination, datasetEmpty, qsBase, listReturnQs, canWrite, isSuper, activeFilterCount: activeCount
    }) %>
  </section>

  <form id="masterFiltersForm" method="get" action="/admin/masters">
    <input type="hidden" name="page" value="1">
    <div class="filterDrawer" id="masterFilters" aria-hidden="true">
      <div class="filterDrawer__backdrop" data-filter-close></div>
      <aside class="filterDrawer__panel filterDrawer__panel--compact" role="dialog" aria-modal="true" aria-labelledby="masterFiltersTitle">
        <div class="filterDrawer__head">
          <h2 id="masterFiltersTitle" class="filterDrawer__title">Filters</h2>
          <button type="button" class="btn btn--ghost btn--mini btn--icon" data-filter-close aria-label="Close filters">×</button>
        </div>
        <div class="filterDrawer__body filterDrawer__body--compact">
          <%- include('partials/admin/masters-filter-drawer', { filters: f, pagination }) %>
        </div>
        <div class="filterDrawer__foot filterDrawer__foot--compact">
          <a class="btn btn--ghost btn--mini" href="/admin/masters">Reset</a>
          <button type="submit" class="btn btn--primary btn--mini">Apply</button>
        </div>
      </aside>
    </div>
  </form>

  <% if (canWrite) { %>
    <%- include('partials/admin/masters-form-drawer') %>
  <% } %>
</div>
<script src="/js/admin-masters.js?v=1" defer></script>