DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=itorus
SESSION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
API_JWT_SECRET=

# Admin — Blog modules (1/0 or true/false). Default: CMS list+edit only; folder import & power tools off.
ADMIN_BLOG_CMS_ENABLED=1
ADMIN_BLOG_FOLDER_IMPORT_ENABLED=1
ADMIN_BLOG_NEW_POST=1
ADMIN_BLOG_IMPORT_CSV=1
ADMIN_BLOG_AI=1
ADMIN_BLOG_TRASH=1
ADMIN_BLOG_POST_DETAIL=1

# Blog CMS — OpenAI (server-side only; never expose to browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_CONCURRENT_REQUESTS=2
OPENAI_MAX_RETRIES=3
OPENAI_REQUEST_TIMEOUT=180000
BLOG_IMPORT_DIR=
BLOG_DEFAULT_AUTHOR=Editorial Team
SITE_BASE_URL=http://localhost:3000
BLOG_IMPORT_MAX_FILE_BYTES=20971522
BLOG_IMPORT_NESTED_DIRS=1
BLOG_IMPORT_ENABLE_DOCX=1
BLOG_IMPORT_BATCH_SIZE=2
BLOG_IMPORT_WORKER_STALE_MINUTES=8
BLOG_IMPORT_BUDGET_USD=0
# Publish imported posts to the live blog after AI processing (Import Studio checkbox can override per job)
BLOG_IMPORT_AUTO_PUBLISH=1
BLOG_IMPORT_WORKER_ENABLED=0
BLOG_IMPORT_WORKER_INTERVAL_MS=45000
BLOG_IMPORT_RATE_IN_PER_M=
BLOG_IMPORT_RATE_OUT_PER_M=
BLOG_IMAGE_MAX_BYTES=5242880
BLOG_IMAGE_ENABLE_WEBP=1
BLOG_IMAGE_MIN_WIDTH=640
BLOG_IMAGE_MIN_HEIGHT=360
BLOG_IMAGE_MAX_WIDTH=3840
BLOG_IMAGE_MAX_HEIGHT=2160
BLOG_PUBLIC_CACHE_MS=60000
BLOG_AUTOSAVE_ENABLED=1
BLOG_SCHEDULE_PUBLISH_ENABLED=0
BLOG_SCHEDULE_PUBLISH_INTERVAL_MS=60000
SITE_NAME=Anannt Urjaa
SITE_LOCALE=en-IN
ORGANIZATION_NAME=Anannt Urjaa
SITE_LOGO_URL=/images/footer_logo1.svg
TWITTER_SITE=
SITE_DEFAULT_DESCRIPTION=